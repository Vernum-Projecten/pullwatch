---
// A screenshot from the app's camera tour (fake data), in the light and the dark version.
// Only the one that matches the site's theme is shown; the other is display: none, and a
// lazy image that is not displayed is never downloaded.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	name: string;
	alt: string;
	/** Width in CSS pixels the image is shown at, at most. */
	maxWidth?: number;
	eager?: boolean;
}

const { name, alt, maxWidth = 1160, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*/*.png', { eager: true });
const pick = (mode: 'light' | 'dark') => {
	const image = images[`../assets/screenshots/${mode}/${name}.png`];
	if (!image) throw new Error(`No ${mode} screenshot named ${name}`);
	return image.default;
};
const light = pick('light');
const dark = pick('dark');
const widths = [480, 720, 960, light.width].filter((w, i, all) => w <= light.width && all.indexOf(w) === i);
const sizes = `(min-width: 72rem) ${maxWidth}px, calc(100vw - 3rem)`;
const common = {
	alt,
	widths,
	sizes,
	formats: ['avif', 'webp'] as const,
	loading: eager ? ('eager' as const) : ('lazy' as const),
	decoding: 'async' as const,
};
---

<figure class="shot" style={`--shot-max: ${maxWidth}px`}>
	<Picture src={light} {...common} formats={[...common.formats]} pictureAttributes={{ class: 'dark:sl-hidden' }} />
	<Picture src={dark} {...common} formats={[...common.formats]} pictureAttributes={{ class: 'light:sl-hidden' }} />
</figure>

<style>
	.shot {
		margin: 0;
		max-width: var(--shot-max);
		width: 100%;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid var(--pw-hairline);
		box-shadow: var(--pw-shadow);
		background: var(--sl-color-bg);
	}
</style>
