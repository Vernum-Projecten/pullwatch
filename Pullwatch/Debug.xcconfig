// Debug-builds (Xcode ⌘R, tests): de gedeelde instellingen plus de test-omgeving.
#include "App.xcconfig"

// De test-GitHub App "TEST Pullwatch" van Vernum-Projecten (github.com/apps/test-pullwatch),
// zodat debug-builds nooit de echte Pullwatch-app gebruiken. Openbaar, geen geheim.
// Een eigen test-app: zet hem in Local.xcconfig (docs/github-app.md).
PW_GITHUB_CLIENT_ID = Iv23likvKTZoOHgDa4N3
PW_GITHUB_APP_SLUG = test-pullwatch

// Debug-builds installeren nooit een update: zonder Sparkle-sleutel blijft alleen de melding.
SPARKLE_PUBLIC_ED_KEY =

// Eigen instellingen per Mac, niet in git (.gitignore); mag ontbreken.
#include? "Local.xcconfig"
