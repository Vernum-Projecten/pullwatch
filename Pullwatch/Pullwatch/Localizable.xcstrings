      }
    },
    "Pullwatch instellingen": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch-Einstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch Settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages de Pullwatch"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch instellingen"
          }
        }
      }
    },
    "Pullwatch is nog nergens geïnstalleerd. Installeer het op je account of een organisatie; daarna verschijnt die hier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch ist noch nirgends installiert. Installiere es für dein Konto oder eine Organisation; danach erscheint sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch isn’t installed anywhere yet. Install it on your account or an organization; it then appears here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch n’est encore installé nulle part. Installez-le sur votre compte ou une organisation ; elle apparaîtra ensuite ici."
          }
        }
      }
    },
    "Pullwatch meldt een nieuwe PR of tag zodra die er is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch meldet einen neuen PR oder Tag, sobald er da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch tells you about a new PR or tag as soon as it appears."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch vous signale une nouvelle PR ou un nouveau tag dès son apparition."
          }
        }
      }
    },
    "Pullwatch meldt een nieuwe PR of tag zodra die er is. macOS vraagt één keer om toestemming.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch meldet einen neuen PR oder Tag, sobald er da ist. macOS fragt einmal nach der Erlaubnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch tells you about a new PR or tag as soon as it appears. macOS asks for permission once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch vous signale une nouvelle PR ou un nouveau tag dès son apparition. macOS demande l’autorisation une seule fois."
          }
        }
      }
    },
    "Pullwatch meldt nieuwe pull requests en tags uit Azure DevOps en GitHub, houdt een doorzoekbare geschiedenis bij en checkt je repo's op verouderde versies en bekende kwetsbaarheden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch meldet neue Pull Requests und Tags aus Azure DevOps und GitHub, führt einen durchsuchbaren Verlauf und prüft deine Repositorys auf veraltete Versionen und bekannte Schwachstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch tells you about new pull requests and tags in Azure DevOps and GitHub, keeps a searchable history and checks your repositories for outdated versions and known vulnerabilities."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch signale les nouvelles pull requests et les nouveaux tags d’Azure DevOps et de GitHub, conserve un historique consultable et vérifie vos dépôts à la recherche de versions obsolètes et de vulnérabilités connues."
          }
        }
      }
    },
    "Pullwatch ziet alleen repositories waar de app geïnstalleerd is. Bij een organisatie installeert een eigenaar hem, of keurt je verzoek goed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch sieht nur Repositorys, in denen die App installiert ist. Bei einer Organisation installiert ein Eigentümer sie oder genehmigt deine Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch only sees repositories where the app is installed. For an organization, an owner installs it or approves your request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch ne voit que les dépôts où l’app est installée. Pour une organisation, un propriétaire l’installe ou approuve votre demande."
          }
        }
      }
    },
