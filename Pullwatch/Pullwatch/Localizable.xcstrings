          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the versions in all followed repositories and looks up the latest version on endoflife.date and the package registries"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les versions de tous les dépôts suivis et recherche la dernière version sur endoflife.date et dans les registres de paquets"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de versies in alle gevolgde repo's en zoekt de nieuwste versie op bij endoflife.date en de package-registers"
          }
        }
      }
    },
    "Leest per gevolgde repo de taal- en frameworkversies en vergelijkt ze met endoflife.date; packages gaan langs OSV.dev voor bekende CVE's": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest für jedes gefolgte Repository die Sprach- und Framework-Versionen und vergleicht sie mit endoflife.date; Pakete werden bei OSV.dev auf bekannte CVEs geprüft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the language and framework versions of each followed repository and compares them with endoflife.date; packages are checked against OSV.dev for known CVEs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les versions de langage et de framework de chaque dépôt suivi et les compare à endoflife.date ; les paquets sont vérifiés sur OSV.dev pour les CVE connues"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest per gevolgde repo de taal- en frameworkversies en vergelijkt ze met endoflife.date; packages gaan langs OSV.dev voor bekende CVE's"
          }
        }
      }
    },
    "Leest per gevolgde repo de taal- en frameworkversies en vergelijkt ze met endoflife.date; packages gaan langs OSV.dev voor bekende CVE's en langs hun register voor de nieuwste versie": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest pro verfolgtem Repository die Sprach- und Framework-Versionen und vergleicht sie mit endoflife.date; Pakete werden bei OSV.dev auf bekannte CVEs und in ihrer Registry auf die neueste Version geprüft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the language and framework versions of each followed repository and compares them with endoflife.date; packages are checked against OSV.dev for known CVEs and against their registry for the latest version"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les versions de langage et de framework de chaque dépôt suivi et les compare à endoflife.date ; les paquets sont vérifiés sur OSV.dev pour les CVE connues et dans leur registre pour la dernière version"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest per gevolgde repo de taal- en frameworkversies en vergelijkt ze met endoflife.date; packages gaan langs OSV.dev voor bekende CVE's en langs hun register voor de nieuwste versie"
