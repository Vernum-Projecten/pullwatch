    "Pullwatch %@ is beschikbaar": {
      "comment": "Meldingstitel; versienummer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch %@ ist verfügbar"
          }
        },
