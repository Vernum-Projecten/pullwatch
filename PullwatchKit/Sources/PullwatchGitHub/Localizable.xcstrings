{
  "sourceLanguage": "nl",
  "strings": {
    "De code is verlopen. Begin opnieuw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen. Beginne von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired. Start again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré. Recommencez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen. Begin opnieuw."
          }
        }
      }
    },
    "GitHub Packages is alleen te lezen met het recht read:packages: gebruik de GitHub CLI (gh auth refresh -s read:packages) of een persoonlijk token (classic) met read:packages. De GitHub App kan dat recht niet krijgen.": {
      "comment": "Reden waarom de packages van een GitHub-account niet te lezen zijn; read:packages en de gh-opdracht niet vertalen",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages is alleen te lezen met het recht read:packages: gebruik de GitHub CLI (gh auth refresh -s read:packages) of een persoonlijk token (classic) met read:packages. De GitHub App kan dat recht niet krijgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages can only be read with the read:packages permission: use the GitHub CLI (gh auth refresh -s read:packages) or a personal access token (classic) with read:packages. The GitHub App cannot get that permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages lässt sich nur mit der Berechtigung read:packages lesen: Verwende die GitHub CLI (gh auth refresh -s read:packages) oder ein persönliches Zugriffstoken (classic) mit read:packages. Die GitHub App kann diese Berechtigung nicht erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages ne peut être lu qu'avec l'autorisation read:packages : utilisez la GitHub CLI (gh auth refresh -s read:packages) ou un jeton d'accès personnel (classic) avec read:packages. La GitHub App ne peut pas obtenir cette autorisation."
          }
        }
      }
    },
    "GitHub antwoordde: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwortete: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub answered: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a répondu : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwoordde: %@"
          }
        }
      }
    },
    "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat abgelehnt. Beginne von vorn und erlaube Pullwatch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub said no. Start again and approve Pullwatch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé. Recommencez et autorisez Pullwatch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed."
          }
        }
      }
    },
    "GraphQL-antwoord zonder co-auteurs en checks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Co-Autoren und Checks"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL response without co-authors and checks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse GraphQL sans co-auteurs ni checks"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-antwoord zonder co-auteurs en checks"
          }
        }
      }
    },
    "GraphQL-antwoord zonder gegevens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL response without data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse GraphQL sans données"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-antwoord zonder gegevens"
          }
        }
      }
    },
    "Inloggen bij GitHub is in deze versie nog niet ingesteld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit GitHub ist in dieser Version noch nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in with GitHub isn’t set up in this version yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec GitHub n’est pas encore configurée dans cette version."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen bij GitHub is in deze versie nog niet ingesteld."
          }
        }
      }
    },
    "Log opnieuw in bij GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut bei GitHub an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to GitHub again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous à GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in bij GitHub."
          }
