{
  "sourceLanguage": "nl",
  "strings": {
    "De code is verlopen. Begin opnieuw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen. Beginne von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired. Start again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré. Recommencez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen. Begin opnieuw."
          }
        }
      }
    },
    "GitHub antwoordde: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwortete: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub answered: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a répondu : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwoordde: %@"
          }
        }
      }
    },
    "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat abgelehnt. Beginne von vorn und erlaube Pullwatch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub said no. Start again and approve Pullwatch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé. Recommencez et autorisez Pullwatch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed."
          }
        }
      }
    },
    "GraphQL-antwoord zonder co-auteurs en checks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Co-Autoren und Checks"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL response without co-authors and checks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse GraphQL sans co-auteurs ni checks"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-antwoord zonder co-auteurs en checks"
          }
        }
      }
    },
    "GraphQL-antwoord zonder gegevens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Daten"
          }
        },
        "en": {
          "stringUnit": {
