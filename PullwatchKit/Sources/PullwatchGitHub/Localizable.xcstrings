{
  "sourceLanguage": "nl",
  "strings": {
    "De code is verlopen. Begin opnieuw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen. Beginne von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired. Start again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré. Recommencez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen. Begin opnieuw."
          }
        }
      }
    },
    "De gebruiker van de GitHub CLI mag de packages van deze eigenaren niet lezen: log in met gh auth login -h %@ als iemand die er wel bij kan.": {
      "comment": "Reden waarom de packages van een GitHub App-account niet te lezen zijn; de host van GitHub; de opdracht niet vertalen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitHub CLI user may not read the packages of these owners: log in with gh auth login -h %@ as someone who can."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Benutzer der GitHub CLI darf die Pakete dieser Eigentümer nicht lesen: Melde dich mit gh auth login -h %@ als jemand an, der darauf zugreifen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisateur de la GitHub CLI ne peut pas lire les paquets de ces propriétaires : connectez-vous avec gh auth login -h %@ en tant que quelqu'un qui y a accès."
          }
        }
      }
    },
    "GitHub Packages is alleen te lezen met de scope read:packages: gebruik de GitHub CLI (gh auth refresh -s read:packages) of een persoonlijk token (classic) met read:packages.": {
      "comment": "Reden waarom de packages van een GitHub-account met de GitHub CLI of een token niet te lezen zijn; read:packages en de gh-opdracht niet vertalen",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages lässt sich nur mit dem Scope read:packages lesen: Verwende die GitHub CLI (gh auth refresh -s read:packages) oder ein persönliches Zugriffstoken (classic) mit read:packages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages can only be read with the read:packages scope: use the GitHub CLI (gh auth refresh -s read:packages) or a personal access token (classic) with read:packages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages ne peut être lu qu'avec le scope read:packages : utilisez la GitHub CLI (gh auth refresh -s read:packages) ou un jeton d'accès personnel (classic) avec read:packages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Packages is alleen te lezen met de scope read:packages: gebruik de GitHub CLI (gh auth refresh -s read:packages) of een persoonlijk token (classic) met read:packages."
          }
        }
      }
    },
    "GitHub antwoordde: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwortete: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub answered: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a répondu : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwoordde: %@"
          }
        }
      }
    },
    "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat abgelehnt. Beginne von vorn und erlaube Pullwatch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub said no. Start again and approve Pullwatch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé. Recommencez et autorisez Pullwatch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft het geweigerd. Begin opnieuw en keur Pullwatch goed."
          }
        }
      }
    },
    "GraphQL-antwoord zonder co-auteurs en checks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Co-Autoren und Checks"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL response without co-authors and checks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse GraphQL sans co-auteurs ni checks"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-antwoord zonder co-auteurs en checks"
          }
        }
      }
    },
    "GraphQL-antwoord zonder gegevens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-Antwort ohne Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL response without data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse GraphQL sans données"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphQL-antwoord zonder gegevens"
          }
        }
      }
    },
    "Inloggen bij GitHub is in deze versie nog niet ingesteld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit GitHub ist in dieser Version noch nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in with GitHub isn’t set up in this version yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec GitHub n’est pas encore configurée dans cette version."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen bij GitHub is in deze versie nog niet ingesteld."
          }
        }
      }
    },
    "Installeer de GitHub CLI (brew install gh) en log in met gh auth login -h %@ -s read:packages: GitHub geeft packages niet aan de GitHub App, Pullwatch leest ze met gh.": {
      "comment": "Reden waarom de packages van een GitHub App-account niet te lezen zijn; de host van GitHub; de opdrachten niet vertalen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the GitHub CLI (brew install gh) and log in with gh auth login -h %@ -s read:packages: GitHub does not give packages to the GitHub App, Pullwatch reads them with gh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die GitHub CLI (brew install gh) und melde dich mit gh auth login -h %@ -s read:packages an: GitHub gibt Pakete nicht an die GitHub App heraus, Pullwatch liest sie mit gh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez la GitHub CLI (brew install gh) et connectez-vous avec gh auth login -h %@ -s read:packages : GitHub ne donne pas les paquets à la GitHub App, Pullwatch les lit avec gh."
          }
        }
      }
    },
    "Log in met de GitHub CLI: gh auth login -h %@ -s read:packages. GitHub geeft packages niet aan de GitHub App, Pullwatch leest ze met gh.": {
      "comment": "Reden waarom de packages van een GitHub App-account niet te lezen zijn; de host van GitHub; de opdracht niet vertalen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in with the GitHub CLI: gh auth login -h %@ -s read:packages. GitHub does not give packages to the GitHub App, Pullwatch reads them with gh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit der GitHub CLI an: gh auth login -h %@ -s read:packages. GitHub gibt Pakete nicht an die GitHub App heraus, Pullwatch liest sie mit gh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec la GitHub CLI : gh auth login -h %@ -s read:packages. GitHub ne donne pas les paquets à la GitHub App, Pullwatch les lit avec gh."
          }
        }
      }
    },
    "Log opnieuw in bij GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut bei GitHub an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to GitHub again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous à GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in bij GitHub."
          }
        }
      }
    },
    "Voer gh auth refresh -h %@ -s read:packages uit: de GitHub CLI mist de scope read:packages.": {
      "comment": "Reden waarom de packages van een GitHub App-account niet te lezen zijn; de host van GitHub; de opdracht en read:packages niet vertalen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run gh auth refresh -h %@ -s read:packages: the GitHub CLI lacks the read:packages scope."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe gh auth refresh -h %@ -s read:packages aus: Der GitHub CLI fehlt der Scope read:packages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez gh auth refresh -h %@ -s read:packages : il manque le scope read:packages à la GitHub CLI."
          }
        }
      }
    },
    "Zet Packages lezen met de GitHub CLI aan voor dit account (Instellingen, Accounts): GitHub geeft packages niet aan de GitHub App.": {
      "comment": "Reden waarom de packages van een GitHub App-account niet gelezen worden; Packages lezen met de GitHub CLI is de naam van de schakelaar in de account-editor",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Read packages with the GitHub CLI for this account (Settings, Accounts): GitHub does not give packages to the GitHub App."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Pakete mit der GitHub CLI lesen für dieses Konto ein (Einstellungen, Konten): GitHub gibt Pakete nicht an die GitHub App heraus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Lire les paquets avec la GitHub CLI pour ce compte (Réglages, Comptes) : GitHub ne donne pas les paquets à la GitHub App."
          }
        }
      }
    }
  },
  "version": "1.0"
}
