    "Typ eigenaar/repo, of plak de link van de repository.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Besitzer/Repo ein oder füge den Link des Repositorys ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type owner/repo, or paste the repository's link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez propriétaire/dépôt, ou collez le lien du dépôt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ eigenaar/repo, of plak de link van de repository."
          }
        }
      }
    },
    "Typ groep/project (ook met subgroepen), of plak de link van het project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Gruppe/Projekt ein (auch mit Untergruppen) oder füge den Link des Projekts ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type group/project (subgroups too), or paste the project's link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez groupe/projet (sous-groupes compris), ou collez le lien du projet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ groep/project (ook met subgroepen), of plak de link van het project."
          }
        }
      }
    },
    "Typ project/repo, of plak de link van de repository.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Projekt/Repo ein oder füge den Link des Repositorys ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type project/repo, or paste the repository's link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez projet/dépôt, ou collez le lien du dépôt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ project/repo, of plak de link van de repository."
          }
        }
