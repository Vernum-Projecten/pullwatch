        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; Automatically check for updates is on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ; Rechercher automatiquement les mises à jour est activé"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; Automatisch op updates controleren staat aan"
          }
        }
