{
  "sourceLanguage": "nl",
  "strings": {
    "%@ niet gevonden (installeer via Homebrew)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht gefunden (über Homebrew installieren)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ not found (install via Homebrew)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ introuvable (installer via Homebrew)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ niet gevonden (installeer via Homebrew)"
          }
        }
      }
    },
    "%@ op %@": {
      "comment": "Organisatie(s), groep(en) of gebruiker(s), dienst (GitHub, Azure DevOps, GitLab of de host van een eigen server)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ auf %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ staat al in de lijst.": {
      "comment": "Repo",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist schon in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already in the list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà dans la liste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat al in de lijst."
          }
        }
      }
    },
