    "@%@ op %@": {
      "comment": "GitHub-login, dienst",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ auf %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ on %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ sur %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "new",
            "value": "@%1$@ op %2$@"
          }
        }
      }
    },
    "Altijd": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forever"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd"
          }
        }
      }
    },
    "Bij deze dienst kun je nog geen losse repositories toevoegen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesem Dienst kannst du noch keine einzelnen Repositorys hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service can't add single repositories yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce service ne permet pas encore d'ajouter des dépôts isolés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij deze dienst kun je nog geen losse repositories toevoegen."
          }
        }
      }
    },
    "CVE-check mislukt: %@": {
      "comment": "Foutmelding",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE-Prüfung fehlgeschlagen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE check failed: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la vérification CVE : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE-check mislukt: %@"
          }
        }
      }
    },
    "CVE-check onvolledig, details ontbreken: %lld van %lld": {
      "comment": "Aantal kwetsbaarheden zonder details, totaal",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE-Prüfung unvollständig, Details fehlen: %1$lld von %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE check incomplete, details missing: %1$lld of %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification CVE incomplète, détails manquants : %1$lld sur %2$lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CVE-check onvolledig, details ontbreken: %1$lld van %2$lld"
          }
        }
      }
    },
    "Deze repository staat in de organisatie %@; dit account hoort bij %@.": {
      "comment": "Organisatie van de link, organisatie van het account",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository liegt in der Organisation %1$@; dieses Konto gehört zu %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repository is in the organisation %1$@; this account belongs to %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt se trouve dans l'organisation %1$@ ; ce compte appartient à %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze repository staat in de organisatie %1$@; dit account hoort bij %2$@."
          }
        }
      }
    },
    "Dit is een link naar %@. Voeg hem toe bij een account van %@.": {
      "comment": "Dienst, twee keer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Link zu %1$@. Füge ihn bei einem %2$@-Konto hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a link to %1$@. Add it to a %2$@ account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un lien vers %1$@. Ajoutez-le à un compte %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een link naar %1$@. Voeg hem toe bij een account van %2$@."
          }
        }
      }
    },
    "Dit project staat op %@; dit account hoort bij %@. Voeg het toe bij een account van die server.": {
      "comment": "Host van de link, host van het account (bv. gitlab.com)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt liegt auf %1$@; dieses Konto gehört zu %2$@. Füge es bei einem Konto dieses Servers hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project is on %1$@; this account belongs to %2$@. Add it to an account on that server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet se trouve sur %1$@ ; ce compte appartient à %2$@. Ajoutez-le à un compte de ce serveur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit project staat op %1$@; dit account hoort bij %2$@. Voeg het toe bij een account van die server."
          }
        }
      }
    },
    "Geen toegang tot \"%@\", controleer de naam": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf „%@“, prüfe den Namen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to \"%@\", check the name"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'accès à « %@ », vérifiez le nom"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot \"%@\", controleer de naam"
          }
        }
      }
    },
